# Validated at boot by src/common/config/env.ts. In production (NODE_ENV=production)
# MONGO_URI, REDIS_URL, FRONTEND_URL, JWT_ACCESS_SECRET (or JWT_SECRET),
# JWT_REFRESH_SECRET, RESEND_API_KEY and RESEND_FROM_EMAIL are required and
# placeholder values are rejected; development falls back to local defaults.
# Blank values (FOO=) count as unset.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/open-poll-platform
REDIS_URL=redis://127.0.0.1:6379
# --- AI provider ---
# Primary: any OpenAI-compatible endpoint (e.g. the Open Quota proxy).
# Leave LLM_BASE_URL/LLM_API_KEY unset to use Gemini directly; unset both to get mock drafts.
LLM_BASE_URL=https://openquota.anands.dev/llm/v1
LLM_API_KEY=your_llm_api_key
# Any id from GET <LLM_BASE_URL>/models. Pin a fast one — "auto" lets the router
# pick and it can land on a slow reasoning model.
# gemini-3.1-flash-lite-preview (fastest, preview) | gemini-2.5-flash-lite (stable)
LLM_MODEL=gemini-3.1-flash-lite-preview
# Fallback: used when the OpenAI-compatible endpoint is unset or fails.
GEMINI_API_KEY=your_gemini_api_key

# App URLs
# The URL of your Next.js frontend (e.g., https://openpoll.anands.dev)
FRONTEND_URL=http://localhost:3000
# Optional extra comma-separated frontend origins (e.g. preview deployments) trusted
# for credentialed CORS and the cookie-authenticated /api/auth/refresh-token and
# /api/auth/logout origin check. FRONTEND_URL's origin is always trusted;
# http://localhost:3000 and http://127.0.0.1:3000 are trusted outside production.
# ALLOWED_ORIGINS=https://preview.openpoll.example

# Optional override for the backend origin in the MCP connector config users copy
# from Settings. Leave unset and the origin is taken from the incoming request
# (correct behind Vercel or any trusted proxy), then VERCEL_PROJECT_PRODUCTION_URL,
# then http://localhost:PORT. Set it only when the public origin differs from the
# one users reach the API on, e.g. https://openpoll-backend.anands.dev
# API_PUBLIC_URL=

# Auth Secrets (required in production; use distinct long random values)
# JWT_SECRET is accepted as a legacy alias for JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# HMAC key for signed ballot/guest/device tokens. Falls back to the JWT access
# secret when unset (a warning is logged in production); set a separate value.
ID_SIGNING_SECRET=replace_with_another_long_random_secret

# Google OAuth (optional). Setting any GOOGLE_* value enables it and makes
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET required (GOOGLE_REDIRECT_URI too in production).
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match the URL registered in Google Console
# Example: https://openpoll-backend.anands.dev/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Internal OpenID Connect provider (Authorization Code + PKCE S256), optional.
# Setting OIDC_CLIENT_ID, OIDC_CLIENT_SECRET or OIDC_REDIRECT_URI enables it and makes
# the client id + secret required (OIDC_REDIRECT_URI too in production).
# OIDC_ISSUER defaults to https://id-backend.anands.dev.
#
# OIDC_REDIRECT_URI must exactly match a redirect URI registered with the IdP and
# must end up on this backend, which holds the oidc_state cookie (path /):
#   - production:  https://<backend-origin>/auth/callback   (or /api/auth/callback)
#   - development: http://localhost:5000/auth/callback      (default when unset), or
#                  http://localhost:3000/api/auth/callback/id, the Next.js dev relay
#                  that forwards to the backend's /api/auth/callback
OIDC_ISSUER=https://id-backend.anands.dev
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/id

# Email (Resend). Required in production. Without an API key (development only)
# emails are logged instead of sent. RESEND_FROM_NAME defaults to "OpenPoll".
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_NAME="OpenPoll"
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Optional platform features. Each group is off while unset; GET /api/capabilities
# reports what this deployment offers. Setting part of a group makes the rest of
# it required (boot fails with the list). Plan limits apply with or without billing.
# ---------------------------------------------------------------------------

# Encryption at rest (AES-256-GCM) for IdP client secrets. Enables per-workspace
# SAML/OIDC SSO and SCIM. 32 random bytes as 64 hex characters or base64:
#   openssl rand -hex 32
# Changing it makes stored SSO secrets unreadable; keep it stable and backed up.
# ENCRYPTION_KEY=

# Stripe billing. STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET enable checkout, the
# customer portal and the webhook (POST /api/billing/webhook). Price ids map
# Stripe prices to plans. Without them billing answers 503 BILLING_DISABLED and
# plans are set by hand: bun scripts/set-plan.ts <workspace> <plan>
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_YEARLY=price_...
# STRIPE_AUTOMATIC_TAX=true collects the billing address and lets Stripe Tax
# compute tax at checkout (Stripe Tax must be set up in the dashboard first).
# STRIPE_AUTOMATIC_TAX=false

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, RustFS) for image
# and video uploads, PPTX/PDF import and data exports. Required when any S3_* is
# set: S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_PUBLIC_URL.
# The bucket needs CORS allowing PUT from the frontend origin (browsers upload
# straight to presigned URLs). S3_PUBLIC_URL is the public/CDN base objects are
# served from. Without storage, uploads answer 503 STORAGE_DISABLED and slides
# can still use pasted https image URLs.
# S3_ENDPOINT may be omitted for AWS S3 (derived from the region). S3_REGION
# defaults to "auto" (R2, MinIO, RustFS); use e.g. us-east-1 for AWS.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=auto
# S3_BUCKET=openpoll-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.openpoll.example

# High-fidelity PPTX import: a Gotenberg container (gotenberg/gotenberg:8, LibreOffice
# route) renders slides the native parser cannot represent (charts, SmartArt, EMF)
# as pictures of the slide. Without it, imports keep editable text and images and
# report warnings. Needs S3 storage for the rendered pictures.
# GOTENBERG_URL=http://gotenberg:3000

# Private Google Slides import through the Drive API + Picker. Public share links
# import without it (and without Google OAuth). Needs Google OAuth above
# (GOOGLE_CLIENT_ID/SECRET), a Picker API key and the numeric Google Cloud project
# number. The browser's Picker hands the API a file id and a short-lived token;
# the token is never stored beyond the job (encrypted with ENCRYPTION_KEY if set).
# GOOGLE_DRIVE_IMPORT_ENABLED=false
# GOOGLE_DRIVE_API_KEY=
# GOOGLE_DRIVE_APP_ID=123456789012

# Import worker (PPTX/PDF/Google Slides jobs). On by default inside the API
# process. For production isolate the CPU-heavy parsing: set
# IMPORT_WORKER_INPROCESS=0 on the API instances and run `bun run worker:import`
# on a separate instance with the same MONGO_URI/REDIS_URL/S3_* settings.
# IMPORT_WORKER_INPROCESS=1
# Jobs one worker process runs at once (1-4).
# IMPORT_WORKER_CONCURRENCY=1

# Custom domains: none (default) | vercel | caddy. DOMAIN_CNAME_TARGET is the
# hostname customers point their CNAME at. vercel attaches domains to the
# frontend project through the Vercel API (token, project id, optional team id);
# caddy relies on Caddy on-demand TLS asking GET /api/public/domains/tls-ask.
# DOMAIN_PROVISIONER=none
# DOMAIN_CNAME_TARGET=cname.openpoll.example
# DOMAIN_VERCEL_TOKEN=
# DOMAIN_VERCEL_PROJECT_ID=
# DOMAIN_VERCEL_TEAM_ID=

# Prometheus metrics at /metrics, readable with "Authorization: Bearer <token>".
# At least 16 characters; unset disables the endpoint.
# METRICS_TOKEN=

# Several backend instances behind one load balancer (see docs/deploy/multi-instance.md):
# "on" links their Socket.io servers through Redis. Leave unset for a single instance.
# SOCKET_REDIS_ADAPTER=on
