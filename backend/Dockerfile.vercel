# Vercel Dockerfile — builds/runs as a Vercel Function on Fluid compute.
# Server must listen on process.env.PORT (already handled in src/app.ts).
FROM oven/bun:latest

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# Migrations are idempotent and lock-guarded, so every instance can run them on boot.
CMD ["bun", "run", "start:prod"]
