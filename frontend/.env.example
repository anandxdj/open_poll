# Backend origin. A trailing /api is accepted and stripped (see lib/env.ts).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Socket.io origin; usually the same as the backend origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public URL of the backend's object storage (backend S3_PUBLIC_URL), read at build
# time into the CSP img-src so uploaded slide images load from a non-https bucket
# in development. Optional: https hosts are allowed anyway.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=
# Where the landing page's "Contact sales" button points (a mailto: link). Without it the
# button is disabled.
NEXT_PUBLIC_SALES_EMAIL=
